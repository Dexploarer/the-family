APP_ENV=development
# Optional pino log level (fatal|error|warn|info|debug|trace); read at bootstrap by logger.ts.
LOG_LEVEL=info
STORAGE_DRIVER=memory
TELEGRAM_BOT_TOKEN=replace-with-bot-token
BSC_CHAIN_ID=56
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
PLATFORM_FEE_RECIPIENT=0x0000000000000000000000000000000000000000
PLATFORM_COMMISSION_RECEIVER=0x0000000000000000000000000000000000000000
TRADE_FEE_BPS=10
POOL_WITHDRAWAL_FEE_BPS=25
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nancy
SAFE_TRANSACTION_SERVICE_URL=https://api.safe.global/tx-service/bnb
SAFE_API_KEY=
DEX_DEADLINE_SECONDS=86400
HTTP_PORT=3000
PUBLIC_BASE_URL=
WALLETCONNECT_PROJECT_ID=
TELEGRAM_WEBHOOK_SECRET=
PINATA_JWT=
RISK_CHECK_MODE=warn
MIN_LIQUIDITY_USD=1000
MAX_BUY_TAX_BPS=1500
MAX_SELL_TAX_BPS=1500
DEPOSIT_WATCH=
PLATFORM_ADMIN_IDS=

# Operator dashboard (/admin) — email login + team roles
ADMIN_BOOTSTRAP_EMAIL=dexploarer@gmail.com
# ADMIN_SESSION_SECRET=generate-a-random-string-at-least-32-chars
# ADMIN_SESSION_TTL_DAYS=7
# Optional: AgentMail magic-link invites (https://console.agentmail.to — otherwise copy link from Team tab)
# AGENTMAIL_API_KEY=am_...
# AGENTMAIL_INBOX_ID=   # optional; auto-provisions inbox nancy-operator-invites if omitted
# Optional break-glass bearer token (legacy)
# PLATFORM_OPS_TOKEN=
# Default media flags when no remote override is stored (on|off)
# VOICE_ENABLED=off
# VIDEO_ENABLED=off

# ElizaCloud deploy (bun run deploy:elizacloud) — see docs/ops/elizacloud-deploy.md
# ELIZACLOUD_API_KEY=
# ELIZACLOUD_AGENT_ID=
# ELIZACLOUD_AGENT_NAME=nancy
# ELIZACLOUD_IMAGE=ghcr.io/dexploarer/nancy:latest
